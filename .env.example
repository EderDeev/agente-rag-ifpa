# Copie para .env e preencha. NUNCA faça commit do arquivo .env.
OPENAI_API_KEY=sk-...

# Modelos (padrões econômicos)
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Fatiamento / recuperação (opcionais)
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# RETRIEVER_TOP_K=4
# RETRIEVER_MAX_DISTANCE=0.75
# BM25_TOP_K=3

# Custo exibido em reais e URL do QR code (opcionais)
# USD_BRL=5.40
# PUBLIC_URL=https://seu-app.up.railway.app

# Blindagem (opcionais)
# MAX_QUESTION_CHARS=1000
# RATE_LIMIT_PER_MINUTE=15
